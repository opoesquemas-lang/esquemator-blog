---
// Página pública de una infografía publicada. SSR (prerender=false): se
// renderiza al vuelo leyendo de Supabase, así publicar = escribir una fila,
// sin rebuild del blog.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EsquematorCTA from '../../components/EsquematorCTA.astro';
import { getPublicacion } from '../../lib/supabase.js';

const { slug } = Astro.params;
const pub = await getPublicacion(slug);

if (!pub) {
  return new Response('Infografía no encontrada', { status: 404 });
}

// Partir el texto del artículo en párrafos (si lo hay).
const parrafos = (pub.texto || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---
<BaseLayout
  title={pub.titulo}
  description={pub.descripcion}
  image={pub.imagen_url}
  type="article"
  publishedDate={new Date(pub.created_at)}
  author={pub.autor || 'Antonio Ferré'}
>
  <Header />
  <main class="wrap">
    <article>
      {pub.categoria && <span class="cat">{pub.categoria}</span>}
      <h1>{pub.titulo}</h1>
      <p class="lead">{pub.descripcion}</p>

      <figure class="infografia">
        <img src={pub.imagen_url} alt={pub.titulo} loading="eager" />
      </figure>

      <div class="editar-cta">
        <div>
          <strong>¿La quieres para ti?</strong>
          <span>Ábrela en Esquemator, edítala a tu gusto y descárgala en PDF. Gratis.</span>
        </div>
        <a href={`https://app.esquemator.com/?infografia=${pub.slug}`} class="btn">✏️ Editar y descargar</a>
      </div>

      {parrafos.length > 0 && (
        <div class="texto">
          {parrafos.map((p) => <p>{p}</p>)}
        </div>
      )}

      <EsquematorCTA />
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .wrap { max-width: 860px; margin: 0 auto; padding: 40px 20px 64px; }
  .cat {
    display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--cyan); margin-bottom: 10px;
  }
  h1 {
    font-family: 'Nunito', sans-serif; font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15; color: var(--navy); letter-spacing: -0.02em; margin-bottom: 14px;
  }
  .lead { font-size: 18px; line-height: 1.6; color: var(--slate-700); margin-bottom: 28px; }
  .infografia {
    margin: 0 0 32px; border-radius: 14px; overflow: hidden;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.10); background: #fff;
  }
  .infografia img { display: block; width: 100%; height: auto; }
  .texto { font-size: 16px; line-height: 1.75; color: var(--slate-700); }
  .texto p { margin: 0 0 16px; }
  .editar-cta {
    display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
    background: linear-gradient(135deg, var(--cyan-bg), #fff);
    border: 1px solid var(--cyan-light); border-radius: 14px; padding: 18px 22px; margin: 0 0 32px;
  }
  .editar-cta strong { display: block; font-size: 16px; color: var(--navy); font-family: 'Nunito', sans-serif; }
  .editar-cta span { display: block; font-size: 14px; color: var(--slate-500); margin-top: 3px; }
  .editar-cta .btn {
    flex-shrink: 0; background: linear-gradient(135deg, var(--navy), var(--cyan)); color: #fff;
    font-weight: 800; font-size: 15px; padding: 12px 22px; border-radius: 10px; text-decoration: none;
    white-space: nowrap;
  }
  .editar-cta .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(15, 61, 92, 0.22); }
</style>
