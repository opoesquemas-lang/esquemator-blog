---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Página no encontrada" description="Esta página no existe.">
  <Header />
  <main class="container error-page">
    <div class="error-icon">🔍</div>
    <h1>Página no encontrada</h1>
    <p>
      La página que buscas no existe o ha sido movida.<br>
      ¿Quieres volver a la home o explorar el blog?
    </p>
    <div class="actions">
      <a href="/" class="btn primary">← Volver al inicio</a>
      <a href="/blog/" class="btn outline">Ver todos los artículos</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .error-page {
    padding: 100px 24px;
    text-align: center;
    max-width: 600px;
  }
  .error-icon {
    font-size: 80px;
    margin-bottom: 24px;
  }
  .error-page h1 {
    font-size: 36px;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .error-page p {
    font-size: 17px;
    color: var(--slate-500);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    transition: all 0.15s;
  }
  .btn.primary {
    background: linear-gradient(135deg, var(--navy), var(--cyan));
    color: white;
  }
  .btn.primary:hover {
    transform: translateY(-2px);
    color: white;
  }
  .btn.outline {
    background: white;
    color: var(--navy);
    border: 1.5px solid var(--slate-200);
  }
  .btn.outline:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
</style>
