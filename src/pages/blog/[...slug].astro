---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EsquematorCTA from '../../components/EsquematorCTA.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Posts relacionados: misma categoría, máximo 3
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Tiempo de lectura estimado (200 palabras/min)
const wordCount = post.body.split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedDate={post.data.date}
  modifiedDate={post.data.updatedDate}
  author={post.data.author}
  keywords={post.data.tags}
>
  <Header />

  <article class="post">
    <header class="post-header">
      <div class="container-narrow">
        <div class="post-meta">
          <a href={`/categoria/${post.data.category.toLowerCase().replace(/\s+/g, '-').replace(/[áàäâ]/g,'a').replace(/[éèëê]/g,'e').replace(/[íìïî]/g,'i').replace(/[óòöô]/g,'o').replace(/[úùüû]/g,'u').replace(/ñ/g,'n')}/`} class="post-cat">
            {post.data.category}
          </a>
          <span class="post-date">{formattedDate}</span>
          <span class="post-read-time">{readTime} min de lectura</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-lead">{post.data.description}</p>
        <div class="post-author">
          <div class="author-avatar">AF</div>
          <div class="author-info">
            <div class="author-name">{post.data.author}</div>
            <div class="author-role">Creador de Esquemator · 10+ años en oposiciones</div>
          </div>
        </div>
      </div>
    </header>

    {post.data.image && (
      <div class="post-hero-image container-narrow">
        <img src={post.data.image} alt={post.data.imageAlt || post.data.title} />
      </div>
    )}

    <div class="post-content container-narrow">
      <Content />
    </div>

    <div class="container-narrow">
      <EsquematorCTA />

      {post.data.tags.length > 0 && (
        <div class="post-tags">
          <strong>Etiquetas:</strong>
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    {related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2>Sigue leyendo</h2>
          <div class="related-grid">
            {related.map(p => (
              <PostCard
                url={`/blog/${p.slug}/`}
                title={p.data.title}
                description={p.data.description}
                date={p.data.date}
                category={p.data.category}
                image={p.data.image}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <Footer />
</BaseLayout>

<style>
  .post-header {
    background: var(--slate-50);
    padding: 50px 0 40px;
    border-bottom: 1px solid var(--slate-200);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 13px;
    color: var(--slate-500);
    flex-wrap: wrap;
  }
  .post-cat {
    background: var(--cyan-bg);
    color: var(--navy);
    padding: 4px 12px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-cat:hover {
    background: var(--cyan);
    color: white;
  }
  .post-header h1 {
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    color: var(--navy);
    margin-bottom: 16px;
  }
  .post-lead {
    font-size: 18px;
    color: var(--slate-500);
    line-height: 1.55;
    margin-bottom: 28px;
  }
  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .author-avatar {
    width: 44px; height: 44px;
    background: linear-gradient(135deg, var(--navy), var(--cyan));
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 15px;
    font-family: 'Nunito', sans-serif;
  }
  .author-name {
    font-weight: 700;
    color: var(--ink);
    font-size: 14px;
  }
  .author-role {
    font-size: 12.5px;
    color: var(--slate-500);
  }

  .post-hero-image {
    margin: 40px auto;
  }
  .post-hero-image img {
    border-radius: 16px;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-content {
    padding: 40px 24px 20px;
  }
  .post-content :global(h2) {
    font-size: 28px;
    color: var(--navy);
    margin: 48px 0 16px;
    line-height: 1.25;
  }
  .post-content :global(h3) {
    font-size: 22px;
    color: var(--navy);
    margin: 36px 0 14px;
    line-height: 1.3;
  }
  .post-content :global(h4) {
    font-size: 18px;
    color: var(--navy);
    margin: 28px 0 12px;
  }
  .post-content :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--slate-700);
    margin-bottom: 20px;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 24px 0;
    padding-left: 24px;
  }
  .post-content :global(li) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--slate-700);
    margin-bottom: 8px;
  }
  .post-content :global(strong) {
    color: var(--navy);
    font-weight: 700;
  }
  .post-content :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-decoration-color: var(--cyan-light);
    text-underline-offset: 3px;
  }
  .post-content :global(a:hover) {
    color: var(--navy);
    text-decoration-color: var(--navy);
  }
  .post-content :global(blockquote) {
    border-left: 4px solid var(--cyan);
    padding: 14px 24px;
    margin: 28px 0;
    background: var(--cyan-bg);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--navy);
  }
  .post-content :global(blockquote p) {
    margin-bottom: 0;
  }
  .post-content :global(code) {
    background: var(--slate-100);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: 'Menlo', 'Monaco', monospace;
    font-size: 14px;
    color: var(--navy);
  }
  .post-content :global(pre) {
    background: var(--ink);
    color: #e2e8f0;
    padding: 20px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 24px 0;
  }
  .post-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }
  .post-content :global(img) {
    border-radius: 12px;
    margin: 24px 0;
  }
  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--slate-200);
    margin: 40px 0;
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--slate-200);
    padding: 12px 16px;
    text-align: left;
  }
  .post-content :global(th) {
    background: var(--slate-50);
    font-weight: 700;
    color: var(--navy);
  }

  .post-tags {
    margin: 32px 0;
    padding: 20px;
    background: var(--slate-50);
    border-radius: 12px;
    font-size: 13.5px;
    color: var(--slate-500);
  }
  .post-tags strong {
    color: var(--navy);
    margin-right: 10px;
  }
  .tag {
    display: inline-block;
    background: white;
    color: var(--slate-700);
    padding: 4px 10px;
    border-radius: 999px;
    margin: 0 4px 4px 0;
    font-size: 12.5px;
    font-weight: 600;
    border: 1px solid var(--slate-200);
  }

  .related-section {
    background: var(--slate-50);
    padding: 60px 0;
    margin-top: 40px;
  }
  .related-section h2 {
    text-align: center;
    margin-bottom: 32px;
    font-size: 26px;
    color: var(--navy);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
</style>
