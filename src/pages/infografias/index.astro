---
// Índice de infografías publicadas. SSR: se genera al vuelo desde Supabase,
// así aparecen sin rebuild.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublicacionesLista } from '../../lib/supabase.js';

const pubs = await getPublicacionesLista();
---
<BaseLayout
  title="Infografías de leyes para opositores | Esquemator"
  description="Esquemas visuales e infografías de artículos y leyes para preparar tu oposición. Descárgalas y repasa de un vistazo."
>
  <Header />
  <main class="wrap">
    <header class="hero">
      <h1>Infografías</h1>
      <p>Esquemas visuales de leyes y artículos para repasar de un vistazo. Ideales para opositores.</p>
    </header>

    {pubs.length === 0 ? (
      <p class="empty">Aún no hay infografías publicadas. ¡Vuelve pronto!</p>
    ) : (
      <div class="grid">
        {pubs.map((p) => (
          <a class="card" href={`/infografia/${p.slug}`}>
            <div class="thumb"><img src={p.imagen_url} alt={p.titulo} loading="lazy" /></div>
            <div class="body">
              {p.categoria && <span class="cat">{p.categoria}</span>}
              <h2>{p.titulo}</h2>
              <p>{p.descripcion}</p>
              <span class="link">Ver infografía →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 40px 20px 64px; }
  .hero { text-align: center; margin-bottom: 40px; }
  .hero h1 {
    font-family: 'Nunito', sans-serif; font-size: clamp(30px, 6vw, 46px);
    color: var(--navy); letter-spacing: -0.02em; margin-bottom: 12px;
  }
  .hero p { font-size: 18px; color: var(--slate-500); max-width: 560px; margin: 0 auto; }
  .empty { text-align: center; color: var(--slate-500); font-size: 16px; padding: 40px 0; }
  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px;
  }
  .card {
    display: block; background: #fff; border: 1px solid var(--slate-200); border-radius: 16px;
    overflow: hidden; color: inherit; text-decoration: none; transition: all 0.2s;
  }
  .card:hover { border-color: var(--cyan); transform: translateY(-3px); box-shadow: 0 14px 40px rgba(15, 61, 92, 0.08); }
  .thumb { aspect-ratio: 4 / 3; background: var(--slate-50); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .body { padding: 16px 18px 20px; }
  .cat {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--cyan); margin-bottom: 8px;
  }
  .body h2 { font-family: 'Nunito', sans-serif; font-size: 19px; color: var(--navy); line-height: 1.25; margin-bottom: 8px; }
  .body p { font-size: 14px; color: var(--slate-500); line-height: 1.5; margin-bottom: 12px; }
  .link { font-size: 14px; font-weight: 700; color: var(--cyan); }
</style>
