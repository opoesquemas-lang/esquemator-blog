---
export interface Props {
  url: string;
  title: string;
  description: string;
  date: Date;
  category: string;
  image?: string;
  featured?: boolean;
}

const { url, title, description, date, category, image, featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<article class:list={['post-card', { featured }]}>
  <a href={url} class="post-link">
    {image && (
      <div class="post-image">
        <img src={image} alt={title} loading="lazy" />
      </div>
    )}
    <div class="post-body">
      <div class="post-meta">
        <span class="post-cat">{category}</span>
        <span class="post-date">{formattedDate}</span>
      </div>
      <h2 class="post-title">{title}</h2>
      <p class="post-desc">{description}</p>
      <span class="post-read">Leer artículo →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: white;
    border: 1px solid var(--slate-200);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.2s;
  }
  .post-card:hover {
    border-color: var(--cyan);
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(15, 61, 92, 0.08);
  }
  .post-card.featured {
    border: 2px solid var(--cyan);
    background: linear-gradient(135deg, white 0%, var(--cyan-bg) 100%);
  }
  .post-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .post-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--slate-100);
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .post-card:hover .post-image img {
    transform: scale(1.03);
  }
  .post-body {
    padding: 24px 24px 22px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 12px;
    color: var(--slate-500);
  }
  .post-cat {
    background: var(--cyan-bg);
    color: var(--navy);
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-title {
    font-size: 19px;
    line-height: 1.3;
    color: var(--navy);
    margin-bottom: 10px;
    font-weight: 800;
  }
  .post-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--slate-500);
    margin-bottom: 14px;
  }
  .post-read {
    font-size: 13px;
    font-weight: 700;
    color: var(--cyan);
  }
  .post-card:hover .post-read {
    color: var(--navy);
  }
</style>
