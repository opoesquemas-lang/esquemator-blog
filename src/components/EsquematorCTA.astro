---
export interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  ctaUrl?: string;
}

const {
  title = '¿Te ahorraría tiempo tener tus esquemas hechos?',
  description = 'Esquemator convierte cualquier artículo del BOE en un esquema visual estructurado en 2 segundos. Sin IA. Texto 100% literal de la ley.',
  ctaText = 'Probar Esquemator gratis →',
  ctaUrl = 'https://app.esquemator.com/login.html',
} = Astro.props;
---
<aside class="cta-box">
  <div class="cta-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={ctaUrl} class="cta-btn">{ctaText}</a>
    <p class="cta-sub">Sin tarjeta · Sin compromiso · Esquemas ilimitados</p>
  </div>
</aside>

<style>
  .cta-box {
    background: linear-gradient(135deg, var(--navy) 0%, var(--cyan) 100%);
    border-radius: 20px;
    padding: 36px 32px;
    margin: 48px 0;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-box::before {
    content: '';
    position: absolute;
    top: -50px; right: -50px;
    width: 200px; height: 200px;
    background: rgba(255,255,255,0.08);
    border-radius: 50%;
  }
  .cta-content {
    position: relative;
    z-index: 2;
  }
  .cta-box h3 {
    font-size: 24px;
    color: white;
    margin-bottom: 12px;
    line-height: 1.2;
  }
  .cta-box p {
    font-size: 15px;
    color: rgba(255,255,255,0.9);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-btn {
    display: inline-block;
    background: white;
    color: var(--navy);
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 15px;
    transition: all 0.15s;
    margin-bottom: 14px;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    color: var(--navy);
  }
  .cta-sub {
    font-size: 12.5px !important;
    color: rgba(255,255,255,0.75) !important;
    margin-bottom: 0 !important;
  }
</style>
