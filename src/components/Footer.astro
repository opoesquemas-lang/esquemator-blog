---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <div class="footer-logo">
        esqu<span class="accent">=</span>mator
      </div>
      <p class="footer-tag">
        Convierte cualquier artículo del BOE en un esquema visual en 2 segundos.
      </p>
      <a href="https://app.esquemator.com/login.html" class="footer-cta">
        Probar gratis →
      </a>
      <a href="https://t.me/+znX_OK7K-ck2Mjg0" target="_blank" rel="noopener"
        onclick="if(typeof gtag==='function')gtag('event','community_click',{source:'footer_blog'})"
        class="footer-tg">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        Comunidad en Telegram
      </a>
    </div>

    <div class="footer-col">
      <h4>Producto</h4>
      <ul>
        <li><a href="https://esquemator.com">Inicio</a></li>
        <li><a href="https://esquemator.com#precios">Precios</a></li>
        <li><a href="https://app.esquemator.com/login.html">Iniciar sesión</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Blog</h4>
      <ul>
        <li><a href="/blog/">Todos los posts</a></li>
        <li><a href="/categoria/oposiciones/">Oposiciones</a></li>
        <li><a href="/categoria/tecnicas-estudio/">Técnicas de estudio</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>OpoEsquemas</h4>
      <ul>
        <li><a href="https://opoesquemas.es">Academia online</a></li>
        <li><a href="https://opoesquemas.es/temarios">Temarios</a></li>
        <li><a href="https://opoesquemas.es/blog">Blog principal</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>
        © {year} Esquemator · Hecho con ❤️ para opositores
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--slate-300);
    margin-top: 80px;
    padding-top: 60px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }
  .footer-col h4 {
    color: white;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    font-family: 'Inter', sans-serif;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col ul a {
    color: var(--slate-400);
    font-size: 14px;
    transition: color 0.15s;
  }
  .footer-col ul a:hover {
    color: var(--cyan);
  }
  .footer-logo {
    font-family: 'Nunito', sans-serif;
    font-size: 26px;
    font-weight: 900;
    color: white;
    margin-bottom: 12px;
  }
  .footer-logo .accent { color: var(--cyan); }
  .footer-tag {
    font-size: 14px;
    color: var(--slate-400);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: 320px;
  }
  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--cyan);
    color: var(--ink);
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    transition: all 0.15s;
  }
  .footer-cta:hover {
    background: white;
    color: var(--navy);
    transform: translateY(-1px);
  }
  .footer-tg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    margin-left: 0;
    color: #38BDF8;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-tg:hover {
    color: white;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px 0;
    font-size: 13px;
    color: var(--slate-500);
    text-align: center;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-col:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
