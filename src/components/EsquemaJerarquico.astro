---
// ════════════════════════════════════════════════════════════════════
//  EsquemaJerarquico
//  Esquema en árbol con niveles lógicos anidados arbitrariamente.
//  Mantiene el marco "navegador de Esquemator" de EsquemaArticulo.
//
//  Uso desde MDX:
//  <EsquemaJerarquico
//    titulo="24"
//    ley="Constitución Española"
//    tiempo="1.1 segundos"
//    arbol={[
//      {
//        tag: '1',
//        label: 'Apartado 1 — Tutela judicial efectiva',
//        tipo: 'principio',
//        hijos: [
//          { label: 'Titular: todas las personas', tipo: 'concepto' },
//          { label: 'Sin indefensión (en ningún caso)', tipo: 'limite' },
//        ],
//      },
//    ]}
//  />
//
//  Tipos disponibles (color/semántica del nodo):
//    principio    — apartado raíz, fondo navy, texto blanco
//    grupo        — categoría intermedia, fondo cyan claro
//    concepto     — hoja neutra (sustantivo, institución)
//    accion       — hoja amber (verbo)
//    limite       — hoja roja (prohibición, plazo, requisito crítico)
//    consecuencia — hoja verde (resultado, efecto)
//
//  Cualquier nodo puede tener `hijos` para anidar otro nivel.
// ════════════════════════════════════════════════════════════════════

export type NodoTipo = 'principio' | 'grupo' | 'concepto' | 'accion' | 'limite' | 'consecuencia';

export interface Nodo {
  label: string;
  tag?: string;          // opcional: prefijo numerado o etiqueta corta
  tipo?: NodoTipo;       // default 'concepto'
  hijos?: Nodo[];
}

export interface Props {
  titulo: string;        // p.ej. "24"
  ley: string;           // p.ej. "Constitución Española"
  tiempo?: string;
  arbol: Nodo[];
}

const { titulo, ley, tiempo = '1.2 segundos', arbol } = Astro.props;

// Render recursivo a HTML string. Mantenido en frontmatter para
// evitar problemas de recursividad en componentes Astro.
function renderNodos(nodos: Nodo[], nivel: number): string {
  return nodos.map((n) => renderNodo(n, nivel)).join('');
}

function renderNodo(nodo: Nodo, nivel: number): string {
  const tipo = nodo.tipo ?? 'concepto';
  const hasHijos = Array.isArray(nodo.hijos) && nodo.hijos.length > 0;

  const tag = nodo.tag
    ? `<span class="ej-tag">${escape(nodo.tag)}</span>`
    : '';
  const label = `<span class="ej-label">${renderPills(nodo.label)}</span>`;

  const hijos = hasHijos
    ? `<ul class="ej-children">${renderNodos(nodo.hijos!, nivel + 1)}</ul>`
    : '';

  return `<li class="ej-node ej-tipo-${tipo} ej-nivel-${nivel}">
    <div class="ej-row">${tag}${label}</div>
    ${hijos}
  </li>`;
}

function escape(s: string): string {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

// Parser de pills (mismo formato que EsquemaArticulo):
//   [palabra] → cyan    (sustantivos / instituciones)
//   {palabra} → amber   (verbos / acciones)
//   !palabra! → rojo    (importante: prohibición, plazo, requisito)
//   @palabra@ → verde   (consecuencia / resultado)
function renderPills(text: string): string {
  return escape(text)
    .replace(/\[([^\]]+)\]/g, '<span class="ej-pill ej-pill-cyan">$1</span>')
    .replace(/\{([^}]+)\}/g, '<span class="ej-pill ej-pill-amber">$1</span>')
    .replace(/!([^!]+)!/g, '<span class="ej-pill ej-pill-red">$1</span>')
    .replace(/@([^@]+)@/g, '<span class="ej-pill ej-pill-green">$1</span>');
}

const treeHtml = `<ul class="ej-tree ej-root">${renderNodos(arbol, 0)}</ul>`;
---
<div class="ej-mockup">
  <!-- Barra superior tipo navegador -->
  <div class="ej-bar">
    <div class="ej-dots">
      <span class="ej-dot r"></span>
      <span class="ej-dot y"></span>
      <span class="ej-dot g"></span>
    </div>
    <div class="ej-url">app.esquemator.com · Editor</div>
  </div>

  <div class="ej-body">
    <div class="ej-meta">
      <span class="ej-meta-dot"></span>
      Generado en {tiempo}
    </div>

    <div class="ej-head">
      <span class="ej-head-label">Artículo</span>
      <span class="ej-head-num">{titulo}</span>
      <span class="ej-head-title">{ley}</span>
    </div>

    <Fragment set:html={treeHtml} />
  </div>
</div>

<style>
  .ej-mockup {
    max-width: 100%;
    margin: 32px 0;
    background: white;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
    overflow: hidden;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* ── barra de navegador (igual que EsquemaArticulo) ── */
  .ej-bar {
    background: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ej-dots { display: flex; gap: 5px; }
  .ej-dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .ej-dot.r { background: #FF5F57; }
  .ej-dot.y { background: #FEBC2E; }
  .ej-dot.g { background: #28C840; }
  .ej-url {
    flex: 1; text-align: center;
    font-size: 11.5px; color: #64748B; font-weight: 500;
  }

  .ej-body { padding: 22px 26px 28px; }

  .ej-meta {
    display: inline-flex; align-items: center; gap: 6px;
    background: #F0FDF4; border: 1px solid #BBF7D0;
    color: #166534; font-size: 10.5px; font-weight: 700;
    padding: 3px 9px; border-radius: 999px; margin-bottom: 12px;
  }
  .ej-meta-dot { width: 5px; height: 5px; background: #16A34A; border-radius: 50%; }

  .ej-head {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid #F1F5F9;
    margin-bottom: 18px;
  }
  .ej-head-label {
    font-size: 10px; font-weight: 700; color: #64748B;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ej-head-num {
    font-family: 'Nunito', 'Inter', sans-serif;
    font-size: 28px; font-weight: 900; color: #1FB7D8; line-height: 1;
  }
  .ej-head-title { font-size: 13px; font-weight: 600; color: #0F172A; }

  /* ── árbol ── */
  .ej-tree {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ej-tree :global(.ej-tree) {
    /* (reservado) hooks adicionales si en el futuro hay más anidaciones */
  }

  .ej-tree :global(.ej-children) {
    list-style: none;
    margin: 6px 0 12px 0;
    padding-left: 22px;
    border-left: 1.5px dashed #CBD5E1;
  }

  .ej-tree :global(.ej-node) {
    position: relative;
    margin: 6px 0;
  }

  /* stub horizontal entre la guía vertical y el nodo hijo */
  .ej-tree :global(.ej-children > .ej-node)::before {
    content: '';
    position: absolute;
    top: 16px;
    left: -22px;
    width: 18px;
    height: 1.5px;
    border-top: 1.5px dashed #CBD5E1;
  }

  .ej-tree :global(.ej-row) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.45;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #0F172A;
    max-width: 100%;
  }

  .ej-tree :global(.ej-tag) {
    flex-shrink: 0;
    background: rgba(15, 61, 92, 0.08);
    color: #0F3D5C;
    font-weight: 800;
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .ej-tree :global(.ej-label) {
    font-weight: 500;
  }

  /* ── pills inline (subrayadores de palabras dentro del texto BOE) ── */
  .ej-tree :global(.ej-pill) {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 12.5px;
    margin: 0 1px;
    line-height: 1.4;
  }
  .ej-tree :global(.ej-pill-cyan)  { background: #E0F2F8; color: #0F3D5C; }
  .ej-tree :global(.ej-pill-amber) { background: #FEF3C7; color: #92400E; }
  .ej-tree :global(.ej-pill-red)   { background: #FEE2E2; color: #B91C1C; }
  .ej-tree :global(.ej-pill-green) { background: #DCFCE7; color: #166534; }

  /* En nodos navy (principio), las pills mantienen contraste alto */
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-pill {
    background: rgba(255, 255, 255, 0.95);
  }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-pill-cyan  { color: #0F3D5C; }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-pill-amber { color: #92400E; }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-pill-red   { color: #B91C1C; }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-pill-green { color: #166534; }

  /* ── tipos ── */
  /* principio: apartado raíz */
  .ej-tree :global(.ej-tipo-principio) > .ej-row {
    background: linear-gradient(135deg, #0F3D5C 0%, #0F172A 100%);
    border-color: #1E5A85;
    color: white;
    font-weight: 700;
    font-size: 14px;
    padding: 9px 14px;
    box-shadow: 0 6px 18px rgba(15, 61, 92, 0.18);
  }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-tag {
    background: rgba(255, 255, 255, 0.18);
    color: #BFE6F0;
  }
  .ej-tree :global(.ej-tipo-principio) > .ej-row .ej-label {
    font-weight: 700;
  }

  /* grupo: categoría intermedia */
  .ej-tree :global(.ej-tipo-grupo) > .ej-row {
    background: #E0F2F8;
    border-color: #BFE6F0;
    color: #0F3D5C;
    font-weight: 700;
  }
  .ej-tree :global(.ej-tipo-grupo) > .ej-row .ej-tag {
    background: #1FB7D8;
    color: white;
  }

  /* concepto: hoja neutra */
  .ej-tree :global(.ej-tipo-concepto) > .ej-row {
    background: #F8FAFC;
    border-color: #E2E8F0;
    color: #0F172A;
  }

  /* accion: verbo */
  .ej-tree :global(.ej-tipo-accion) > .ej-row {
    background: #FEF3C7;
    border-color: #FBBF24;
    color: #78350F;
    font-weight: 600;
  }

  /* limite: prohibición / requisito crítico */
  .ej-tree :global(.ej-tipo-limite) > .ej-row {
    background: #FEE2E2;
    border-color: #FECACA;
    color: #B91C1C;
    font-weight: 700;
  }

  /* consecuencia: resultado */
  .ej-tree :global(.ej-tipo-consecuencia) > .ej-row {
    background: #DCFCE7;
    border-color: #BBF7D0;
    color: #166534;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .ej-body { padding: 18px 16px 22px; }
    .ej-tree :global(.ej-children) { padding-left: 16px; }
    .ej-tree :global(.ej-children > .ej-node)::before {
      left: -16px;
      width: 12px;
    }
    .ej-tree :global(.ej-row) { font-size: 13px; }
    .ej-tree :global(.ej-tipo-principio) > .ej-row { font-size: 13.5px; }
  }
</style>
